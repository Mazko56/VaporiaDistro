# Railway will inject PORT. Local development uses 3000.
PORT=3000
NODE_ENV=development
# PostgreSQL connection from Railway Postgres service:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaporia
# Telegram bot token from @BotFather. Never publish this token.
BOT_TOKEN=
# This must be your HTTPS Railway domain (NO trailing slash)
PUBLIC_URL=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
# Telegram numeric user IDs, separated by commas (not usernames)
ADMIN_TELEGRAM_IDS=
# Optionally notify a private admin chat/channel via chat id
ADMIN_CHAT_ID=
# Demo catalog. TRUE for first preview; FALSE for a clean live catalog.
SEED_DEMO_DATA=true
# Local only; ALWAYS false on Railway.
DEV_AUTH_ENABLED=true
BONUS_PERCENT=5
# Public brand text displayed in the app
STORE_NAME=VAPORIA DISTRO
# Keep false until a lawyer checks rules for age verification / online retail.
ENABLE_CHECKOUT=false
